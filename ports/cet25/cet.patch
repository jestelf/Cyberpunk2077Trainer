@@ -8,3 +8,17 @@ RenderContext* RenderContext::GetInstance() noexcept
     static RED4ext::UniversalRelocPtr<RenderContext*> s_instance(CyberEngineTweaks::AddressHashes::CRenderGlobal_InstanceOffset);
     return *s_instance.GetAddr();
 }
+
+IDXGISwapChain4* RenderContext::GetSwapChain(int32_t index) const noexcept
+{
+    if (index < 1 || index > 0x20) return nullptr;
+    const size_t start = CETLocal25::IsVerifiedBuild() ? 0xCEBF48 : 0xC97F38;
+    const auto offset = start + static_cast<size_t>(index - 1) * 0xB0;
+    return *reinterpret_cast<IDXGISwapChain4* const*>(reinterpret_cast<const uint8_t*>(this) + offset);
+}
+
+ID3D12CommandQueue* RenderContext::GetDirectQueue() const noexcept
+{
+    const size_t offset = CETLocal25::IsVerifiedBuild() ? 0x14104D0 : 0x13BC4D0;
+    return *reinterpret_cast<ID3D12CommandQueue* const*>(reinterpret_cast<const uint8_t*>(this) + offset);
+}
